<?xml version="1.0"?>
<!-- ===========================================================================
     ros2_control.xacro : binds the URDF joints to the STM32 hardware plugin.

     Read by:  controller_manager (ros2_control_node), which parses the
               robot_description parameter and instantiates this plugin.

     steps_per_rev = motor_steps_per_rev * microstepping * gear_ratio
                   = 200 * 16 * 1.0
                   = 3200
     THIS MUST EQUAL MB_STEPS_PER_REV in stm32/Core/Inc/minibot_config.h.
     If they disagree, the Pi and the STM32 disagree about what a "step" is, and
     your odometry is wrong by exactly that ratio — silently.

     max_step_rate MUST EQUAL MB_MAX_STEP_RATE (1066). It is the Pi-side clamp.

     NOTE: max_step_rate did NOT change in revision 2, even though the wheels did.
     Step rate depends only on RPM and microstepping — not on wheel size. The
     wheel radius only affects how much DISTANCE those steps produce. That is why
     the firmware needed no change at all when the geometry was corrected.
     The MCU clamps too (belt and braces), but if the Pi clamps first then the
     MCU's CLAMPED flag genuinely means "somebody misconfigured a limit upstream"
     rather than "rounding".

     Both numbers are generated by tools/generate_config.py. Do not hand-tune.

     DRV8825 microstep jumpers (M2 M1 M0):
        0 0 0 = full   0 0 1 = 1/2    0 1 0 = 1/4
        0 1 1 = 1/8    1 0 0 = 1/16   1 0 1 = 1/32
=========================================================================== -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <ros2_control name="MinibotSystem" type="system">
    <hardware>
      <plugin>minibot_hardware/StepperDiffDrive</plugin>

      <param name="device">/dev/ttyAMA0</param>
      <param name="baud_rate">115200</param>
      <param name="timeout_ms">1000</param>

      <param name="left_wheel_name">left_wheel_joint</param>
      <param name="right_wheel_name">right_wheel_joint</param>

      <param name="steps_per_rev">3200</param>
      <param name="max_step_rate">1066</param>

      <!-- Prefer fixing direction in the FIRMWARE (MB_LEFT_DIR_INVERT /
           MB_RIGHT_DIR_INVERT) so the STM32's own step counts are correct even
           when you drive it with the bench-test script. These exist only as an
           escape hatch if you cannot reflash right now. -->
      <param name="left_invert">false</param>
      <param name="right_invert">false</param>
    </hardware>

    <joint name="left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-3.0</param>
        <param name="max">3.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-3.0</param>
        <param name="max">3.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
